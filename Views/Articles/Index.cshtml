@model List<Article>
@{
    ViewData["Title"] = "Gestion de stock";
    var deps = ViewBag.Departements as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<form method="get" class="toolbar">
    <input type="search" name="recherche" value="@ViewBag.Recherche" placeholder="🔍 Description, code, code-barres, SKU…" class="grow" />
    <select name="departement" class="form-control" style="width:auto">
        <option value="">Tous les départements</option>
        @if (deps != null)
        {
            foreach (var d in deps)
            {
                <option value="@d.Value" selected="@(d.Value == (string?)ViewBag.Departement)">@d.Text</option>
            }
        }
    </select>
    <select name="filtre" class="form-control" style="width:auto">
        <option value="">Tous</option>
        <option value="actifs" selected="@(((string?)ViewBag.Filtre) == "actifs")">Actifs</option>
        <option value="inactifs" selected="@(((string?)ViewBag.Filtre) == "inactifs")">Inactifs</option>
        <option value="faible" selected="@(((string?)ViewBag.Filtre) == "faible")">Stock faible</option>
    </select>
    <button class="btn btn-primary" type="submit">Filtrer</button>
    <a class="btn btn-success" asp-action="Create">➕ Nouvel article</a>
</form>

<div class="card">
    <div class="card-header">
        <span>@ViewBag.Total article(s)</span>
    </div>
    <div class="card-body" style="padding:0;">
        <div class="table-wrap">
            <table class="grid">
                <thead>
                    <tr>
                        <th>Code</th><th>Description</th><th>Département</th>
                        <th class="num">Coûtant</th><th class="num">Prix vente</th><th class="num">Marge</th>
                        <th class="num">En main</th><th>Statut</th><th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><strong>@a.ArticleId</strong>@(string.IsNullOrEmpty(a.CUP1) ? "" : $" · {a.CUP1}")</td>
                        <td>@a.Description</td>
                        <td><span class="badge badge-gris">@a.Departement</span></td>
                        <td class="num">@((a.Coutant ?? 0).ToString("C2"))</td>
                        <td class="num">@((a.PrixVente ?? 0).ToString("C2"))</td>
                        <td class="num">@a.MargeBeneficiaire.ToString("0.#")%</td>
                        <td class="num">
                            @if (a.StockFaible)
                            {
                                <span class="badge badge-rouge">@((a.QteMain ?? 0).ToString("N0"))</span>
                            }
                            else
                            {
                                @((a.QteMain ?? 0).ToString("N0"))
                            }
                        </td>
                        <td>
                            @if (a.Actif)
                            {
                                <span class="badge badge-vert">Actif</span>
                            }
                            else
                            {
                                <span class="badge badge-gris">Inactif</span>
                            }
                        </td>
                        <td style="white-space:nowrap">
                            <a class="btn btn-light btn-sm" asp-action="Details" asp-route-id="@a.ArticleId">Voir</a>
                            <a class="btn btn-light btn-sm" asp-action="Edit" asp-route-id="@a.ArticleId">✎</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="vide">Aucun article trouvé.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    int page = ViewBag.Page; int totalPages = ViewBag.TotalPages;
}
@if (totalPages > 1)
{
    <div class="pagination">
        @if (page > 1)
        {
            <a asp-action="Index" asp-route-page="@(page-1)" asp-route-recherche="@ViewBag.Recherche" asp-route-departement="@ViewBag.Departement" asp-route-filtre="@ViewBag.Filtre">‹ Préc.</a>
        }
        <span class="actif">Page @(page) / @totalPages</span>
        @if (page < totalPages)
        {
            <a asp-action="Index" asp-route-page="@(page+1)" asp-route-recherche="@ViewBag.Recherche" asp-route-departement="@ViewBag.Departement" asp-route-filtre="@ViewBag.Filtre">Suiv. ›</a>
        }
    </div>
}
