@model InscriptionModel
@{
    ViewData["Title"] = "Créer un compte";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Créer un compte · Inventaire TPV</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .login-wrap { min-height: 100vh; display: grid; place-items: center;
            background: linear-gradient(135deg, var(--bleu-fonce) 0%, var(--bleu-moyen) 100%); padding: 20px; }
        .login-card { background: #fff; width: 100%; max-width: 440px; border-radius: 16px;
            box-shadow: var(--ombre-lg); overflow: hidden; }
        .login-head { background: var(--bleu-fonce); color: #fff; padding: 28px; text-align: center; }
        .login-head .logo { width: 56px; height: 56px; background: var(--bleu-accent); border-radius: 14px;
            display: grid; place-items: center; font-weight: 800; font-size: 22px; margin: 0 auto 12px;
            box-shadow: 0 6px 18px rgba(37,99,235,.5); }
        .login-head h1 { margin: 0; font-size: 21px; }
        .login-head p { margin: 6px 0 0; color: #94a3b8; font-size: 13px; }
        .login-body { padding: 26px 28px; }
        .login-body .form-group { margin-bottom: 14px; }
        .login-foot { text-align: center; padding: 0 28px 24px; color: var(--gris-texte); font-size: 13.5px; }
    </style>
</head>
<body>
<div class="login-wrap">
    <div class="login-card">
        <div class="login-head">
            <div class="logo">TPV</div>
            <h1>Créer un compte</h1>
            <p>Inventaire TPV — Gestion & ventes</p>
        </div>
        <div class="login-body">
            <form asp-action="Inscription" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger" style="margin-bottom:14px"></div>
                <div class="form-group">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Jean Tremblay" />
                </div>
                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" placeholder="vous@exemple.com" />
                </div>
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Au moins 6 caractères" />
                </div>
                <div class="form-group" style="margin-bottom:18px">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                </div>
                <button type="submit" class="btn btn-primary btn-lg btn-block">Créer mon compte</button>
            </form>
        </div>
        <div class="login-foot">
            Vous avez déjà un compte ?
            <a asp-action="Login" style="font-weight:600">Se connecter</a>
        </div>
    </div>
</div>
</body>
</html>
