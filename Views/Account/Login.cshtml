@model LoginModel
@{
    ViewData["Title"] = "Connexion";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion · Inventaire TPV</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .login-wrap { min-height: 100vh; display: grid; place-items: center;
            background: linear-gradient(135deg, var(--bleu-fonce) 0%, var(--bleu-moyen) 100%); padding: 20px; }
        .login-card { background: #fff; width: 100%; max-width: 400px; border-radius: 16px;
            box-shadow: var(--ombre-lg); overflow: hidden; }
        .login-head { background: var(--bleu-fonce); color: #fff; padding: 30px; text-align: center; }
        .login-head .logo { width: 60px; height: 60px; background: var(--bleu-accent); border-radius: 14px;
            display: grid; place-items: center; font-weight: 800; font-size: 24px; margin: 0 auto 14px;
            box-shadow: 0 6px 18px rgba(37,99,235,.5); }
        .login-head h1 { margin: 0; font-size: 22px; }
        .login-head p { margin: 6px 0 0; color: #94a3b8; font-size: 13px; }
        .login-body { padding: 28px; }
        .login-body .form-group { margin-bottom: 16px; }
    </style>
</head>
<body>
<div class="login-wrap">
    <div class="login-card">
        <div class="login-head">
            <div class="logo">TPV</div>
            <h1>Inventaire TPV</h1>
            <p>Gestion & ventes</p>
        </div>
        <div class="login-body">
            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger" style="margin-bottom:14px"></div>
                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" autofocus placeholder="admin@inventaire.local" />
                </div>
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                </div>
                <label class="form-check" style="margin-bottom:18px">
                    <input asp-for="Souvenir" type="checkbox" /> Se souvenir de moi
                </label>
                <button type="submit" class="btn btn-primary btn-lg btn-block">Se connecter</button>
            </form>
        </div>
        <div style="text-align:center; padding:0 28px 24px; color:var(--gris-texte); font-size:13.5px;">
            Pas encore de compte ?
            <a asp-action="Inscription" style="font-weight:600">Créer un compte</a>
        </div>
    </div>
</div>
</body>
</html>
