@model List<ValeurStockLigne>
@{ ViewData["Title"] = "Valeur du stock"; }

<div class="toolbar">
    <a class="btn btn-light" asp-action="Index">‹ Rapports</a>
</div>

<div class="kpi-grid">
    <div class="kpi orange"><div class="label">Valeur au coûtant</div><div class="valeur">@(((decimal)ViewBag.TotalCout).ToString("C0"))</div></div>
    <div class="kpi vert"><div class="label">Valeur au prix de vente</div><div class="valeur">@(((decimal)ViewBag.TotalVente).ToString("C0"))</div></div>
    <div class="kpi"><div class="label">Marge potentielle</div><div class="valeur">@((((decimal)ViewBag.TotalVente)-((decimal)ViewBag.TotalCout)).ToString("C0"))</div></div>
</div>

<div class="card">
    <div class="card-header">Répartition par département</div>
    <div class="card-body" style="padding:0;">
        <div class="table-wrap">
            <table class="grid">
                <thead><tr><th>Département</th><th class="num">Articles</th><th class="num">Qté totale</th><th class="num">Valeur coûtant</th><th class="num">Valeur vente</th></tr></thead>
                <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td><span class="badge badge-bleu">@l.Departement</span></td>
                        <td class="num">@l.NbArticles</td>
                        <td class="num">@l.QteTotale.ToString("N0")</td>
                        <td class="num">@l.ValeurCout.ToString("C2")</td>
                        <td class="num">@l.ValeurVente.ToString("C2")</td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="vide">Aucune donnée.</td></tr>
                }
                </tbody>
                <tfoot>
                    <tr>
                        <td>TOTAL</td>
                        <td class="num">@Model.Sum(l => l.NbArticles)</td>
                        <td class="num">@Model.Sum(l => l.QteTotale).ToString("N0")</td>
                        <td class="num">@(((decimal)ViewBag.TotalCout).ToString("C2"))</td>
                        <td class="num">@(((decimal)ViewBag.TotalVente).ToString("C2"))</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
