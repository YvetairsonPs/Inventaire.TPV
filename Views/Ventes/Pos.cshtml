@{
    ViewData["Title"] = "Point de vente";
    ViewData["PleinEcran"] = true;
}

<div class="pos2">
    <!-- ===== Colonne 1 : Facture / reçu ===== -->
    <div class="pos-col">
        <div class="recu">
            <div class="recu-head">
                <div class="magasin">INVENTAIRE TPV</div>
                <div class="infos">Caisse @User.Identity?.Name</div>
            </div>
            <div class="recu-meta">
                <span>FACTURE: <strong id="noFacture">—</strong></span>
                <span>@DateTime.Now.ToString("dd-MMM-yyyy HH:mm")</span>
            </div>
            <ul class="recu-lignes" id="panier">
                <li class="vide" id="panierVide">Aucun article</li>
            </ul>
            <div class="recu-tot">
                <div class="l"><span>SOUS-TOTAL</span><span id="sousTotal">0,00 $</span></div>
                <div class="l"><span>TPS (5 %)</span><span id="tps">0,00 $</span></div>
                <div class="l"><span>TVQ (9,975 %)</span><span id="tvq">0,00 $</span></div>
                <div class="l total"><span>TOTAL</span><span id="total">0,00 $</span></div>
                <div class="l arrondi"><span>TOT. ARRONDI</span><span id="arrondi">0,00 $</span></div>
                <div class="l monnaie" id="ligneMonnaie" style="display:none"><span>MONNAIE</span><span id="monnaie">0,00 $</span></div>
            </div>
            <div class="recu-art">Nombre d'articles : <strong id="nbItems">0</strong></div>
            <div style="text-align:center;">
                <a id="btnImprimer" class="btn btn-light" target="_blank" style="display:none; margin:10px auto;">🖨️ Imprimer le reçu</a>
            </div>
        </div>

        <!-- ===== Pavé numérique + fonctions (centrés sous le reçu) ===== -->
        <div class="card pos-centre"><div class="card-body" style="display:flex;flex-direction:column;gap:12px;">
            <div class="pad-ecran"><small id="padMode">MONTANT / QTÉ</small><span id="padEcran">0,00</span></div>
            <div class="pad">
                <button data-d="7">7</button><button data-d="8">8</button><button data-d="9">9</button>
                <button data-d="4">4</button><button data-d="5">5</button><button data-d="6">6</button>
                <button data-d="1">1</button><button data-d="2">2</button><button data-d="3">3</button>
                <button data-d="0">0</button><button data-d="00">00</button><button id="padClear" style="color:var(--rouge)">C</button>
            </div>
            <div class="btn-grid">
                <button class="btn-fn fn-gris" id="btnQte"><span class="ic">✖️</span>Qté ×</button>
                <button class="btn-fn fn-orange" id="btnPlu"><span class="ic">🔢</span>Code PLU</button>
            </div>
        </div></div>
    </div>

    <!-- ===== Colonne 3 : Recherche + paiement + départements ===== -->
    <div class="pos-col">
        <div class="card"><div class="card-body pos-search" style="position:relative">
            <input type="search" id="recherche" autocomplete="off" placeholder="🔍 Scanner un code-barres ou chercher un article…" autofocus />
            <ul class="pos-results" id="resultats"></ul>
        </div></div>

        <div id="banner"></div>

        <div class="card"><div class="card-body" style="display:flex;flex-direction:column;gap:10px;">
            <div class="reste-box" id="resteBox"><span id="resteLabel">RESTE À PAYER</span><span class="montant" id="reste">0,00 $</span></div>
            <ul class="paie-liste" id="paiements"></ul>
            <div style="font-size:11.5px;color:var(--gris-texte)">Astuce : tapez un montant au pavé pour un <strong>paiement partiel</strong>, sinon la touche règle le solde complet.</div>
            <div class="tenders">
                <button class="tender" data-cash="5">ARGENT 5 $</button>
                <button class="tender" data-cash="10">ARGENT 10 $</button>
                <button class="tender" data-cash="20">ARGENT 20 $</button>
            </div>
            <div class="tenders">
                <button class="tender argent" id="btnArgent">💵 ARGENT</button>
                <button class="tender interac" id="btnInterac">💳 INTERAC</button>
                <button class="tender argent" id="btnAutre" style="background:#7c3aed">AUTRE</button>
            </div>
            <button class="btn-encaisser" id="btnEncaisser" disabled>✓ RÉGLER LE SOLDE (comptant)</button>
        </div></div>

        <div class="card"><div class="card-body">
            <div class="btn-grid">
                <button class="btn-fn fn-bleu" id="btnVoirPrix"><span class="ic">🔍</span>Voir prix</button>
                <button class="btn-fn fn-fonce" id="btnAttente"><span class="ic">⏸️</span>En attente</button>
                <button class="btn-fn fn-fonce" id="btnListe"><span class="ic">📋</span>Liste attente</button>
                <button class="btn-fn fn-gris" id="btnTiroir"><span class="ic">🗄️</span>Tiroir</button>
                <button class="btn-fn fn-orange" id="btnRetour"><span class="ic">↩️</span>Retour article</button>
                <button class="btn-fn fn-rouge" id="btnAnnuler"><span class="ic">✖️</span>Annuler vente</button>
            </div>
        </div></div>

        <div class="card">
            <div class="card-header">Départements</div>
            <div class="card-body"><div class="deps" id="deps">Chargement…</div></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const TPS = 0.05, TVQ = 0.09975;
let panier = [];
let entry = "";        // saisie pavé en centimes (string)
let qteMult = 1;       // multiplicateur de quantité
let retourMode = false;
const fmt = n => (n || 0).toLocaleString('fr-CA', { style: 'currency', currency: 'CAD' });
const $ = id => document.getElementById(id);

/* ---------- Pavé numérique ---------- */
function entryValue() { return (parseInt(entry || "0", 10)) / 100; }
function rafraichirPad() { $('padEcran').textContent = entryValue().toLocaleString('fr-CA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
document.querySelectorAll('.pad button[data-d]').forEach(b =>
    b.addEventListener('click', () => { entry += b.dataset.d; if (entry.length > 9) entry = entry.slice(0, 9); rafraichirPad(); }));
$('padClear').addEventListener('click', () => { entry = ""; qteMult = 1; $('padMode').textContent = "MONTANT / QTÉ"; rafraichirPad(); });

$('btnQte').addEventListener('click', () => {
    const n = parseInt(entry || "0", 10);
    qteMult = n > 0 ? n : 1;
    $('padMode').textContent = `QTÉ ×${qteMult} — choisir article/dépt`;
    entry = ""; rafraichirPad();
});
$('btnPlu').addEventListener('click', () => { if (entry) { chercherExact($('padEcran').dataset.raw || entry); } recherche.focus(); });

/* ---------- Recherche / scan ---------- */
const recherche = $('recherche'), resultats = $('resultats');
let timer;
recherche.addEventListener('input', () => { clearTimeout(timer); const t = recherche.value.trim(); if (!t) { resultats.innerHTML = ''; return; } timer = setTimeout(() => chercher(t), 180); });
recherche.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); const f = resultats.querySelector('li[data-id]'); if (f) f.click(); else if (recherche.value.trim()) chercherExact(recherche.value.trim()); } });

async function chercher(terme) {
    const r = await fetch(`@Url.Action("Rechercher", "Ventes")?terme=${encodeURIComponent(terme)}`);
    const data = await r.json();
    resultats.innerHTML = data.map(a => `
        <li data-id="${a.id}" data-desc="${esc(a.description)}" data-prix="${a.prix}" data-t1="${a.taxe1}" data-t2="${a.taxe2}">
            <div><strong>${esc(a.description)}</strong><br><small style="color:#64748b">${esc(a.code)} · stock ${a.stock}</small></div>
            <strong>${fmt(a.prix)}</strong></li>`).join('') || '<li class="vide">Aucun résultat</li>';
    resultats.querySelectorAll('li[data-id]').forEach(li => li.addEventListener('click', () => {
        ajouter({ id: li.dataset.id, description: li.dataset.desc, prix: parseFloat(li.dataset.prix), t1: li.dataset.t1 === 'true', t2: li.dataset.t2 === 'true' });
        recherche.value = ''; resultats.innerHTML = ''; recherche.focus();
    }));
}
async function chercherExact(terme) {
    const r = await fetch(`@Url.Action("Rechercher", "Ventes")?terme=${encodeURIComponent(terme)}`);
    const data = await r.json();
    if (data.length) { const a = data[0]; ajouter({ id: a.id, description: a.description, prix: a.prix, t1: a.taxe1, t2: a.taxe2 }); recherche.value = ''; resultats.innerHTML = ''; }
    else banner('Article introuvable : ' + terme, 'warning');
}

/* ---------- Panier ---------- */
function ajouter(a) {
    const q = (retourMode ? -1 : 1) * qteMult;
    const ex = panier.find(p => p.id === a.id && p.prix === a.prix && !p.retour === !retourMode);
    if (ex) ex.qte += q; else panier.push({ id: a.id, description: a.description, prix: a.prix, qte: q, t1: a.t1, t2: a.t2, retour: retourMode });
    qteMult = 1; retourMode = false; $('btnRetour').style.outline = '';
    $('ligneMonnaie').style.display = 'none';
    $('btnImprimer').style.display = 'none';
    rendre();
}
function rendre() {
    const ul = $('panier');
    ul.querySelectorAll('.rl').forEach(e => e.remove());
    $('panierVide').style.display = panier.length ? 'none' : 'block';
    let st = 0, tps = 0, tvq = 0, nb = 0;
    panier.forEach((p, i) => {
        const lt = p.prix * p.qte; st += lt; nb += p.qte;
        if (p.t1) tps += lt * TPS; if (p.t2) tvq += lt * TVQ;
        const li = document.createElement('li');
        li.className = 'rl' + (p.qte < 0 ? ' ret' : '');
        li.innerHTML = `<span class="rl-del" data-del="${i}">×</span>
            <span class="rl-desc">${esc(p.description)}${(p.t1 || p.t2) ? ' <small style="color:#94a3b8">' + (p.t1 ? 'F' : '') + (p.t2 ? 'P' : '') + '</small>' : ''}</span>
            <input class="rl-qte" type="number" step="1" value="${p.qte}" data-i="${i}">
            <span class="rl-prix">${fmt(lt)}</span>`;
        ul.appendChild(li);
    });
    ul.querySelectorAll('input[data-i]').forEach(inp => inp.addEventListener('change', () => { panier[inp.dataset.i].qte = parseInt(inp.value) || 1; rendre(); }));
    ul.querySelectorAll('[data-del]').forEach(b => b.addEventListener('click', () => { panier.splice(b.dataset.del, 1); rendre(); }));
    const total = st + tps + tvq;
    const arr = Math.round(total / 0.05) * 0.05;
    $('sousTotal').textContent = fmt(st); $('tps').textContent = fmt(tps); $('tvq').textContent = fmt(tvq);
    $('total').textContent = fmt(total); $('arrondi').textContent = fmt(arr);
    $('nbItems').textContent = nb;
    $('btnEncaisser').disabled = panier.length === 0;
    window._total = total; window._arrondi = arr;
    rendrePaiements();
}

/* ---------- Départements ---------- */
const COULEURS = { 'VIN': '#a8901f', 'BIERE': '#c79a1e', 'BIÈRE': '#c79a1e', 'TABAC': '#e8732c', 'LAIT': '#3aa0d1',
    'SURGELE': '#2f6fb0', 'SURGELÉ': '#2f6fb0', 'LOTO': '#2f6fb0', 'CONFISERIE': '#b5179e', 'LIQUEURS': '#3aa0d1',
    'GRATTEUX': '#5b2fb0', 'DEPOT BOUT.': '#c0392b', 'RETOUR BOUT.': '#16a34a', 'CARTE APPEL': '#a8901f', 'AUTOBUS': '#e8732c' };
const PALETTE = ['#2563eb', '#0f766e', '#b45309', '#7c3aed', '#be123c', '#15803d', '#0369a1', '#9d174d'];
function couleurDep(code, i) { return COULEURS[code?.toUpperCase()] || PALETTE[i % PALETTE.length]; }

async function chargerDeps() {
    const r = await fetch('@Url.Action("Departements", "Ventes")');
    const deps = await r.json();
    $('deps').innerHTML = deps.map((d, i) => `
        <button class="dep-btn" style="background:${couleurDep(d.code, i)}"
            data-code="${esc(d.code)}" data-desc="${esc(d.desc)}" data-t1="${d.taxe1}" data-t2="${d.taxe2}">
            ${esc(d.code)}<small>${d.taxe1 || d.taxe2 ? 'taxable' : 'détaxé'}</small></button>`).join('') || 'Aucun département';
    $('deps').querySelectorAll('.dep-btn').forEach(b => b.addEventListener('click', () => {
        const montant = entryValue();
        if (montant <= 0) { banner('Entrez un montant au pavé avant de choisir un département.', 'warning'); return; }
        ajouter({ id: b.dataset.code.substring(0, 16), description: b.dataset.desc, prix: montant, t1: b.dataset.t1 === 'true', t2: b.dataset.t2 === 'true' });
        entry = ""; rafraichirPad();
    }));
}

/* ---------- Fonctions ---------- */
$('btnRetour').addEventListener('click', () => { retourMode = !retourMode; $('btnRetour').style.outline = retourMode ? '3px solid #fff' : ''; banner(retourMode ? 'Mode RETOUR actif : le prochain article sera en négatif.' : 'Mode retour annulé.', 'info'); });
$('btnAnnuler').addEventListener('click', () => { if (panier.length && confirm('Annuler toute la vente ?')) { panier = []; paiements = []; $('ligneMonnaie').style.display = 'none'; rendre(); } });
$('btnTiroir').addEventListener('click', () => banner('🗄️ Ouverture du tiroir-caisse (simulation).', 'info'));
$('btnVoirPrix').addEventListener('click', async () => {
    const t = recherche.value.trim() || ($('padEcran').textContent);
    const r = await fetch(`@Url.Action("Rechercher", "Ventes")?terme=${encodeURIComponent(recherche.value.trim())}`);
    const data = await r.json();
    if (data.length) banner(`💲 ${data[0].description} : ${fmt(data[0].prix)} (stock ${data[0].stock})`, 'info');
    else banner('Aucun article correspondant.', 'warning');
});
$('btnAttente').addEventListener('click', () => {
    if (!panier.length) return;
    const liste = JSON.parse(localStorage.getItem('posAttente') || '[]');
    liste.push({ h: new Date().toLocaleTimeString('fr-CA'), panier });
    localStorage.setItem('posAttente', JSON.stringify(liste));
    panier = []; paiements = []; rendre(); banner('Vente mise en attente.', 'success');
});
$('btnListe').addEventListener('click', () => {
    const liste = JSON.parse(localStorage.getItem('posAttente') || '[]');
    if (!liste.length) { banner('Aucune vente en attente.', 'info'); return; }
    const idx = prompt('Ventes en attente :\n' + liste.map((v, i) => `${i + 1}) ${v.h} — ${v.panier.length} article(s)`).join('\n') + '\n\nNuméro à rappeler :');
    const n = parseInt(idx) - 1;
    if (n >= 0 && n < liste.length) { panier = liste[n].panier; liste.splice(n, 1); localStorage.setItem('posAttente', JSON.stringify(liste)); rendre(); banner('Vente rappelée.', 'success'); }
});

/* ---------- Paiement fractionné (argent + interac + monnaie) ---------- */
let paiements = [];   // {methode, tendu, applique, change}
const round2 = n => Math.round((n + Number.EPSILON) * 100) / 100;
function totalApplique() { return round2(paiements.reduce((s, p) => s + p.applique, 0)); }
function reste() { return round2(Math.max(0, (window._arrondi || 0) - totalApplique())); }
function monnaieTotale() { return round2(paiements.reduce((s, p) => s + (p.change || 0), 0)); }

function rendrePaiements() {
    const ul = $('paiements');
    ul.innerHTML = paiements.map((p, i) => `<li>
        <span class="m">${p.methode} ${fmt(p.applique)}${p.change ? ` <span class="chg">(reçu ${fmt(p.tendu)} · monnaie ${fmt(p.change)})</span>` : ''}</span>
        <span class="rm" data-rm="${i}" title="Retirer ce paiement">×</span></li>`).join('');
    ul.querySelectorAll('[data-rm]').forEach(b => b.addEventListener('click', () => { paiements.splice(b.dataset.rm, 1); rendre(); }));
    const r = reste();
    const box = $('resteBox');
    if (panier.length && paiements.length && r <= 0) { box.classList.add('paye'); $('resteLabel').textContent = 'PAYÉ ✓'; }
    else { box.classList.remove('paye'); $('resteLabel').textContent = 'RESTE À PAYER'; }
    $('reste').textContent = fmt(r);
}

// methode : 'Comptant' | 'Interac' | 'Autre'.  montantForce : montant imposé (touches rapides).
function appliquerPaiement(methode, montantForce) {
    if (!panier.length) { banner('Aucun article à encaisser.', 'warning'); return; }
    const r = reste();
    if (r <= 0) { banner('Le solde est déjà réglé.', 'info'); return; }
    const saisi = (montantForce != null) ? montantForce : entryValue();
    // Comptant : peut dépasser le solde (→ monnaie). Carte : plafonné au solde.
    const tendu = methode === 'Comptant' ? (saisi > 0 ? saisi : r) : (saisi > 0 ? Math.min(saisi, r) : r);
    const applique = round2(Math.min(tendu, r));
    const change = methode === 'Comptant' ? round2(tendu - applique) : 0;
    paiements.push({ methode, tendu, applique, change });
    entry = ""; rafraichirPad();
    rendre();
    if (reste() <= 0) finaliser();
}

document.querySelectorAll('.tender[data-cash]').forEach(b => b.addEventListener('click', () => appliquerPaiement('Comptant', parseFloat(b.dataset.cash))));
$('btnArgent').addEventListener('click', () => appliquerPaiement('Comptant'));
$('btnInterac').addEventListener('click', () => appliquerPaiement('Interac'));
$('btnAutre').addEventListener('click', () => appliquerPaiement('Autre'));
$('btnEncaisser').addEventListener('click', () => appliquerPaiement('Comptant', reste())); // règle le solde exact, sans monnaie

async function finaliser() {
    const desc = paiements.map(p => `${p.methode} ${fmt(p.applique)}`).join(' + ');
    const monnaie = monnaieTotale();
    $('btnEncaisser').disabled = true;
    const dto = { methodePaiement: desc, lignes: panier.map(p => ({ articleId: p.id, description: p.description, prixUnitaire: p.prix, quantite: p.qte, taxe1: p.t1, taxe2: p.t2 })) };
    try {
        const res = await (await fetch('@Url.Action("Enregistrer", "Ventes")', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(dto) })).json();
        if (res.success) {
            $('noFacture').textContent = res.facture;
            if (monnaie > 0) { $('monnaie').textContent = fmt(monnaie); $('ligneMonnaie').style.display = 'flex'; }
            const lien = $('btnImprimer');
            lien.href = '@Url.Action("Recu", "Ventes")/' + res.id;
            lien.style.display = 'inline-flex';
            banner(`✓ Vente ${res.facture} — ${fmt(res.total)} · ${desc}${monnaie > 0 ? ' · Monnaie à rendre ' + fmt(monnaie) : ''}`, 'success');
            panier = []; paiements = []; entry = ""; qteMult = 1; rafraichirPad(); rendre();
        } else { banner('Erreur : ' + (res.message || 'inconnue'), 'warning'); }
    } catch (e) { banner('Erreur réseau : ' + e.message, 'warning'); }
}

/* ---------- Utilitaires ---------- */
function banner(msg, type) {
    const cls = { success: 'alert-success', warning: 'alert-warning', info: 'alert-info' }[type] || 'alert-info';
    $('banner').innerHTML = `<div class="alert ${cls} pos-banner">${esc(msg)}</div>`;
    if (type === 'success' || type === 'info') setTimeout(() => { if ($('banner').firstChild) $('banner').innerHTML = ''; }, 6000);
}
function esc(s) { return (s || '').toString().replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

rafraichirPad(); rendre(); chargerDeps();
</script>
}
